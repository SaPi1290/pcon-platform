#cloud-config
# Wird nur beim allerersten Start ausgeführt.
users:
  - name: pcon
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${admin_key}
      - ${ci_key}
disable_root: true
ssh_pwauth: false
package_update: true
packages:
  - python3
  - sudo
