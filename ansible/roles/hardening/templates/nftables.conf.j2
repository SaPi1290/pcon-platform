#!/usr/sbin/nft -f
# Verwaltet durch Ansible (pcon-platform). Manuelle Änderungen werden überschrieben.
#
# Bewusst KEIN "flush ruleset": Docker legt eigene Regeln an, die erhalten bleiben müssen.
# Pcon-Regeln liegen in einer eigenen Tabelle "inet pcon" und werden nur dort ersetzt.

# Alte Tabelle aus der ersten Version entfernen (blockierte Docker-Weiterleitung).
table inet filter
delete table inet filter

table inet pcon
delete table inet pcon

table inet pcon {
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif "lo" accept
{% for ifc in hardening_trusted_interfaces %}
    iifname "{{ ifc }}" accept
{% endfor %}
    meta l4proto { icmp, ipv6-icmp } accept
    tcp dport { {{ hardening_tcp_ports | join(', ') }} } accept
    udp dport { {{ hardening_udp_ports | join(', ') }} } accept
  }
}
